    "react-dom": "^18.3.1",
    "vite": "^5.4.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.0",
    "@types/node": "^20.19.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.8.3",
    "wrangler": "^4.18.0"
