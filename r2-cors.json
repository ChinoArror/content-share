{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://content.aryuki.com"
        ],
        "methods": [
          "GET",
          "HEAD",
          "PUT"
        ],
        "headers": [
          "content-type",
          "content-disposition",
          "cache-control",
          "range"
        ]
      },
      "exposeHeaders": [
        "etag",
        "content-length",
        "content-range",
        "accept-ranges"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
